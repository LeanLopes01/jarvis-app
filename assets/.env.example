# Copy this file to assets/.env and set your token server sandbox ID,
# found in your LiveKit Cloud project's Settings page.
# Without it, the app connects to a default agent.
LIVEKIT_SANDBOX_ID='your-livekit-sandbox-id'
LIVEKIT_AGENT_NAME='my-agent'
# Home server control API: starts the agent on demand and stops it after the call.
JARVIS_API_URL=https://your-jarvis-api.example.com
